# Development only. Production requests must attach a bearer token from the selected OIDC provider.
VITE_DEVELOPMENT_USER_ID=local-user
VITE_DEVELOPMENT_USER_EMAIL=
# Leave blank for local Vite proxy; use https://api.rezzie.org in Cloudflare Pages production.
VITE_API_BASE_URL=
# Firebase web configuration values are public identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_CHROME_EXTENSION_IDS=
# Public Stripe Price IDs are safe to expose in the web bundle.
VITE_CREDIT_PACK_PRICE_ID=
VITE_CREDIT_PACK_CREDITS=5
VITE_SUBSCRIPTION_PRICE_ID=

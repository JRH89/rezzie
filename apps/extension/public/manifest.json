{
  "manifest_version": 3,
  "name": "Rezzie",
  "version": "0.1.1",
  "description": "Tailor a truthful, job-specific resume from the job page you are viewing using your saved Rezzie resumes and credits.",
  "homepage_url": "https://rezzie.org",
  "action": {
    "default_title": "Tailor this job with Rezzie",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "offscreen", "downloads"],
  "host_permissions": [
    "https://rezzie.org/*",
    "https://api.rezzie.org/*",
    "https://*.indeed.com/*",
    "https://*.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.builtin.com/*",
    "https://*.builtinla.com/*",
    "https://*.jackandjilljobs.com/*",
    "https://*.dice.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.monster.com/*",
    "https://*.careerbuilder.com/*",
    "https://*.simplyhired.com/*",
    "https://*.wellfound.com/*",
    "https://*.flexjobs.com/*",
    "https://*.idealist.org/*",
    "https://*.jobcase.com/*",
    "https://*.snagajob.com/*",
    "https://*.usajobs.gov/*",
    "https://*.governmentjobs.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.paylocity.com/*",
    "https://*.paycomonline.net/*",
    "https://*.ultipro.com/*",
    "https://*.successfactors.com/*",
    "https://*.taleo.net/*",
    "https://*.dayforcehcm.com/*",
    "https://*.recruitee.com/*",
    "https://*.teamtailor.com/*",
    "https://*.personio.de/*",
    "https://*.rippling.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://rezzie.org https://api.rezzie.org https://securetoken.googleapis.com https://identitytoolkit.googleapis.com https://www.googleapis.com; frame-src https://rezzie.org;"
  }
}

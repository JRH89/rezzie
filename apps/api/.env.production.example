# Rezzie production domain configuration. Keep secrets in your host's secret manager.
ENVIRONMENT=production
APP_URL=https://rezzie.org
ALLOWED_ORIGINS=https://rezzie.org
ALLOWED_HOSTS=api.rezzie.org

# Firebase project values
OIDC_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
OIDC_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
OIDC_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=16384
ANTHROPIC_EFFORT=medium
# Current one-instance production database. Docker Compose persists it in rezzie_api_data.
DATABASE_URL=sqlite:////data/rezzie.db
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_SUBSCRIPTION_MONTHLY_CREDITS=50
STRIPE_CREDIT_PACKS={"price_replace_me":20}
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
RATE_LIMIT_SALT=replace-with-a-long-random-secret
# Verified Firebase email permitted to access the private support queue.
ADMIN_EMAIL=jaredroberthooker@gmail.com
# Managed Cloudflare Tunnel token; never commit the actual value.
CLOUDFLARE_TUNNEL_TOKEN=

# Rezzie production domain configuration. Keep secrets in your host's secret manager.
ENVIRONMENT=production
APP_URL=https://rezzie.org
ALLOWED_ORIGINS=https://rezzie.org
ALLOWED_HOSTS=api.rezzie.org

# Firebase project values
OIDC_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
OIDC_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
OIDC_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://rezzie:replace_me@YOUR_DATABASE_HOST/rezzie
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_SUBSCRIPTION_MONTHLY_CREDITS=20
STRIPE_CREDIT_PACKS={"price_replace_me":5}
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Managed Cloudflare Tunnel token; never commit the actual value.
CLOUDFLARE_TUNNEL_TOKEN=
